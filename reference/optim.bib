	issn = {02780062},
	url = {http://ieeexplore.ieee.org/document/52985/},
	doi = {10.1109/42.52985},
	abstract = {A new method of reconstructionfrom SPECT data is proposed, which builds on the EM approach to maximum likelihood reconstruction from emission tomography data, but aims instead at maximum posterior probability estimation, that takes account of prior belief about “smoothness” in the isotope concentration. A novel modification to the EM algorithm yields a practical method. The method is illustrated by an application to data from brain scans.},
	language = {en},
	number = {1},
	urldate = {2025-10-10},
	journal = {IEEE Transactions on Medical Imaging},
	author = {Green, P.J.},
	month = mar,
	year = {1990},
	pages = {84--93},
	file = {PDF:/home/sacha.bouchez-delotte/snap/zotero-snap/common/Zotero/storage/SICKJVZ6/Green - 1990 - Bayesian reconstructions from emission tomography data using a modified EM algorithm.pdf:application/pdf},
}

